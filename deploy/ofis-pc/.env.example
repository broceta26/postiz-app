# install.ps1 writes the real .env next to this file. Never commit .env.
# Values marked <generated> are filled automatically; the rest you paste later.

# === Public address (Tailscale Funnel host of the office PC)
MAIN_URL=https://<generated>.ts.net
FRONTEND_URL=https://<generated>.ts.net
NEXT_PUBLIC_BACKEND_URL=https://<generated>.ts.net/api

# === Secrets
JWT_SECRET=<generated>
POSTGRES_PASSWORD=<generated>
TEMPORAL_DB_PASSWORD=<generated>

# === Access
# Only the very first account can register; everyone else joins by invite.
DISABLE_REGISTRATION=true
API_LIMIT=30

# === Channels (fill in, then run install.ps1 again)
# Telegram: create a bot with @BotFather
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=
# Facebook Pages + Instagram (Business): one Meta app
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# LinkedIn Pages: app with the Community Management API product
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# === Optional
# AI writer inside Postiz (not needed for our approved batches)
OPENAI_API_KEY=
# watchdog.ps1 sends "Postiz is down/up again" here (numeric chat id; same bot as above)
ALERT_CHAT_ID=
